name: deep-research
description: "Autonomous deep research agent executing single iteration cycles with externalized state"
mode: subagent
temperature: 0.1
permission:
  read: allow
  write: allow
  edit: allow
  bash: allow
  grep: allow
  glob: allow
  webfetch: allow
  chrome_devtools: deny
  browser: deny
  task: deny
  list: allow
  patch: deny
  external_directory: allow
